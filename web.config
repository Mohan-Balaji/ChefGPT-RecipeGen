<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified"/>
    </handlers>
    <httpPlatform processPath="D:\home\Python39\python.exe"
                  arguments="D:\home\site\wwwroot\app.py"
                  stdoutLogEnabled="true"
                  stdoutLogFile="D:\home\LogFiles\python.log"
                  startupTimeLimit="60"
                  startupRetryCount="3">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="D:\home\site\wwwroot"/>
        <environmentVariable name="PYTHONUNBUFFERED" value="1"/>
        <environmentVariable name="OMP_NUM_THREADS" value="1"/>
        <environmentVariable name="MKL_NUM_THREADS" value="1"/>
        <environmentVariable name="NUMEXPR_NUM_THREADS" value="1"/>
        <environmentVariable name="OPENBLAS_NUM_THREADS" value="1"/>
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
